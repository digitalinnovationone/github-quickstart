# Copie para .env e preencha localmente. Nunca publique tokens ou senhas reais.
PORTAL_ENV=development
PORTAL_SECRET_KEY=gere-uma-chave-aleatoria-forte
PORTAL_PUBLIC_URL=http://127.0.0.1:5000
PORTAL_HOST=127.0.0.1
PORTAL_PORT=5000
PORTAL_DATABASE_PATH=portal.sqlite3

# Aplicativo OAuth e bot próprios do Portal Pandora (não reutilize o token do Project Sphere).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_VIP_ROLE_ID=
DISCORD_ADMIN_IDS=

# Credenciais de teste do Mercado Pago no desenvolvimento; use credenciais de produção
# somente depois de validar o webhook em um endereço público HTTPS.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# Opcional: administração do servidor por REST em localhost ou VPN/rede privada.
PALWORLD_API_URL=http://127.0.0.1:8212
PALWORLD_ADMIN_PASSWORD=
